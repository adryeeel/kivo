{
    "name": "@kivo/ui",
    "private": true,
    "type": "module",
    "exports": {
        "./icons/*": "./src/components/icons/*.tsx",
        "./providers/motion": "./src/providers/motion/index.ts",
        "./providers/theme": "./src/providers/theme/index.ts",
        "./styles.css": "./src/styles/global.css",
        "./components/*": "./src/components/*.tsx",
        "./lib/*": "./src/lib/*.ts",
        "./hooks/*": "./src/hooks/*.ts"
    },
    "scripts": {
        "test:watch": "vitest",
        "test:check": "vitest run",
        "test:related": "vitest related --run",
        "fmt:fix": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint:check": "oxlint",
        "lint:fix": "oxlint --fix",
        "type:check": "tsc --noEmit"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "lucide-react": "^1.77.0",
        "motion": "^14.9.0",
        "next-themes": "^0.4.6",
        "shadcn": "^4.23.0",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@kivo/oxfmt": "workspace:*",
        "@kivo/oxlint": "workspace:*",
        "@kivo/typescript": "workspace:*",
        "@kivo/vitest": "workspace:*",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@vitest/browser-playwright": "catalog:",
        "playwright": "catalog:",
        "tailwindcss": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:",
        "vitest-browser-react": "catalog:"
    },
    "peerDependencies": {
        "@tailwindcss/postcss": "catalog:",
        "react": "catalog:",
        "react-dom": "catalog:"
    }
}
