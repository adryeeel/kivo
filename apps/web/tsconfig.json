{
    "extends": "@project-template/typescript/next",
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"]
        },
        "resolveJsonModule": true,
        "moduleResolution": "bundler"
    },
    "include": [
        "next-env.d.ts",
        "**/*.ts",
        "**/*.tsx",
        ".next/types/**/*.ts",
        ".next/dev/types/**/*.ts"
    ],
    "exclude": ["node_modules", ".next"]
}
