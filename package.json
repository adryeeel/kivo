{
  "name": "kivo",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=24 <27" },
  "scripts": {
    "dev": "pnpm --filter @kivo/web dev",
    "build": "pnpm --filter @kivo/web build",
    "preview": "pnpm --filter @kivo/web preview",
    "lint": "pnpm --filter @kivo/web lint",
    "typecheck": "pnpm --filter @kivo/web typecheck",
    "test": "pnpm --filter @kivo/web test",
    "format": "pnpm --filter @kivo/web format",
    "format:check": "pnpm --filter @kivo/web format:check"
  }
}
