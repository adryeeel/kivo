{
    "name": "kivo",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter @kivo/web dev",
        "build": "pnpm --filter @kivo/web build",
        "start": "pnpm --filter @kivo/web start",
        "lint": "oxlint --deny-warnings .",
        "typecheck": "pnpm -r typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check ."
    },
    "devDependencies": {
        "@kivo/config": "workspace:*",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "vitest": "5.1.1"
    },
    "engines": {
        "node": ">=24 <27"
    },
    "packageManager": "pnpm@12.14.0"
}
