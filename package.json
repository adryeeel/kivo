{
    "name": "kivo",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "pnpm --filter @kivo/web dev",
        "build": "pnpm --filter @kivo/web build",
        "start": "pnpm --filter @kivo/web start",
        "lint": "oxlint --deny-warnings .",
        "typecheck": "pnpm -r typecheck",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint:staged": "lint-staged --concurrent false",
        "commitlint": "commitlint",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@kivo/config": "workspace:*",
        "husky": "9.1.7",
        "lint-staged": "17.6.1",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "vitest": "5.1.1"
    },
    "engines": {
        "node": ">=24 <27"
    },
    "packageManager": "pnpm@12.14.0"
}
